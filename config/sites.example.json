{
  "request": {
    "user_agent": "DataAnaStudentProject/1.1 (+https://github.com/phonghoang01905-code/it-job-market-analysis_nhom_1)",
    "delay_seconds": 4,
    "timeout_seconds": 20,
    "retries": 2
  },
  "sites": [
    {
      "name": "itviec",
      "base_url": "https://itviec.com",
      "robots_url": "https://itviec.com/robots.txt",
      "enabled": true,
      "list_urls": [
        "https://itviec.com/it-jobs"
      ],
      "selectors": {
        "card": ".job-card",
        "title": "h3 a",
        "company": ".small-text a[href^=\"/companies/\"]",
        "location": "div[title].text-truncate",
        "salary": ".salary",
        "skills": "a[data-responsive-tag-list-target=\"tag\"]",
        "url": "h3 a",
        "posted_date": ".ipy-2 > div > span.small-text",
        "work_model": "div.text-rich-grey.flex-shrink-0"
      },
      "max_pages": 1,
      "fetch_descriptions": true,
      "detail_selectors": {
        "description": ".paragraph"
      }
    },
    {
      "name": "topcv",
      "base_url": "https://www.topcv.vn",
      "robots_url": "https://www.topcv.vn/robots.txt",
      "enabled": true,
      "max_pages": 1,
      "page_param": "page",
      "fetch_descriptions": true,
      "list_urls": [
        "https://www.topcv.vn/tim-viec-lam-it"
      ],
      "selectors": {
        "card": ".job-ta",
        "title": "h3.title a span, h3.title",
        "company": ".company-name",
        "location": ".address.truncate",
        "salary": ".salary",
        "skills": ".tag a.item-tag",
        "url": "h3.title a",
        "description": ".job-description",
        "posted_date": ".label-update"
      },
      "detail_selectors": {
        "description": ".box-job-information-detail-item"
      }
    },
    {
      "name": "topdev",
      "base_url": "https://topdev.vn",
      "robots_url": "https://topdev.vn/robots.txt",
      "enabled": true,
      "list_urls": [
        "https://topdev.vn/jobs/search"
      ],
      "max_pages": 1,
      "fetch_descriptions": true,
      "adapter": "topdev",
      "it_category_id": 1,
      "detail_selectors": {}
    }
  ]
}
