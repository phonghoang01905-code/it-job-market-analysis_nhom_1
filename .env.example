# Copy to .env. Values in the shell or GitHub Secrets override this file.
DATABASE_URL=postgresql://data_ana:CHANGE_ME@127.0.0.1:55432/it_job_market
# Only needed if choosing Docker Compose instead of local_postgres.
POSTGRES_PASSWORD=CHANGE_ME
# A project assumption for conversion, not a live exchange rate.
USD_VND_RATE=25000

# none | telegram | email | both
ALERT_CHANNEL=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# Optional path to an existing PostgreSQL bin directory for local_postgres.
POSTGRES_BIN=
